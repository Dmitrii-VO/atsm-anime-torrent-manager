/* Тёмная тема (ТЗ §24) */

QWidget {
    background-color: $bg;
    color: $text;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QLabel#screenTitle {
    font-size: 16pt;
    font-weight: 600;
    color: $text;
}

QLabel#muted, QLabel#emptyState {
    color: $text_muted;
}

QLabel#emptyState {
    font-size: 12pt;
    padding: 60px 0;
}

QLabel#statusLabel {
    color: $text_muted;
    padding: 4px 10px;
}

/* --- кнопки --- */

QPushButton {
    background-color: $hover;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 7px 16px;
    color: $text;
}

QPushButton:hover  { background-color: $selection; }
QPushButton:pressed{ background-color: $surface_alt; }
QPushButton:disabled {
    background-color: $surface;
    color: $disabled_text;
    border-color: $border;
}

QPushButton#primaryButton {
    background-color: $accent;
    border: none;
    font-weight: 600;
    color: $accent_text;
}
QPushButton#primaryButton:hover   { background-color: $accent_hover; }
QPushButton#primaryButton:pressed { background-color: $accent_pressed; }
QPushButton#primaryButton:disabled{ background-color: $disabled_bg; color: $disabled_text; }

QPushButton#secondaryButton { background-color: transparent; }
QPushButton#secondaryButton:hover { background-color: $hover; }

/* --- вкладки-навигация --- */

QTabWidget::pane {
    border: none;
    background: $bg;
}

QTabBar::tab {
    background: transparent;
    color: $text_muted;
    padding: 9px 20px;
    margin-right: 4px;
    border-radius: 8px;
}

QTabBar::tab:selected {
    background: $hover;
    color: $text;
    font-weight: 600;
}

QTabBar::tab:hover:!selected { color: $text; }

/* --- поля ввода --- */

QLineEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: $accent;
}

QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: $accent;
}

QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: $surface;
    border: 1px solid $border;
    selection-background-color: $accent;
    outline: none;
}

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid $border;
    border-radius: 4px;
    background: $surface;
}
QCheckBox::indicator:checked {
    background: $accent;
    border-color: $accent;
}

/* --- списки и таблицы --- */

QListView, QTableView {
    background-color: $bg;
    border: none;
    outline: none;
    alternate-background-color: $surface_alt;
    selection-background-color: $selection;
    selection-color: $text;
}

QTableView::item { padding: 6px 8px; }

QHeaderView::section {
    background-color: $surface;
    color: $text_muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: 7px 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: $border;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: $border; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 5px;
    min-width: 30px;
}

/* --- прочее --- */

QSplitter::handle { background: $border; width: 2px; }

QMenu {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item { padding: 7px 22px; border-radius: 6px; }
QMenu::item:selected { background-color: $accent; }
QMenu::separator { height: 1px; background: $border; margin: 5px 8px; }

QGroupBox {
    border: 1px solid $border;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: $text_muted;
}

QToolTip {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 6px;
}

QProgressBar {
    background: $surface;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk { background: $accent; border-radius: 4px; }
